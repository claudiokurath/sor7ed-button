{
  "name": "@sor7ed/core",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@sor7ed/types": "*",
    "@vercel/functions": "^3.10.3",
    "bullmq": "^5.28.1",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./src/*": {
      "types": "./src/*",
      "development": "./src/*",
      "default": "./dist/*"
    }
  }
}
