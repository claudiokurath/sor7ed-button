{
  "manifest_version": 3,
  "name": "Sorted \u2014 save to your WhatsApp",
  "version": "0.1.1",
  "icons": {
    "16": "icons/scribble-16.png",
    "32": "icons/scribble-32.png",
    "48": "icons/scribble-48.png",
    "128": "icons/scribble-128.png"
  },
  "description": "Choose a page to save through your Sorted account and WhatsApp thread.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/scribble-16.png",
      "32": "icons/scribble-32.png",
      "48": "icons/scribble-48.png",
      "128": "icons/scribble-128.png"
    },
    "default_title": "Save this page with Sorted"
  }
}
