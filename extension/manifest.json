{
  "manifest_version": 3,
  "name": "SOR7ED",
  "version": "0.2.1",
  "host_permissions": [
    "https://www.sor7ed.com/*"
  ],
  "icons": {
    "16": "icons/scribble-16.png",
    "32": "icons/scribble-32.png",
    "48": "icons/scribble-48.png",
    "128": "icons/scribble-128.png"
  },
  "description": "Save articles, videos and web pages to your SOR7ED account and WhatsApp thread.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/scribble-16.png",
      "32": "icons/scribble-32.png",
      "48": "icons/scribble-48.png",
      "128": "icons/scribble-128.png"
    },
    "default_title": "Save this page with SOR7ED"
  },
  "short_name": "SOR7ED"
}
