# ── Infrastructure ──────────────────────────────────────────
DATABASE_URL=postgres://sor7ed:sor7ed@localhost:5432/sor7ed
REDIS_URL=redis://localhost:6379

# ── Meta WhatsApp Cloud API ─────────────────────────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WEBHOOK_VERIFY_TOKEN=
# App secret from Meta App Dashboard → Settings → Basic.
# Distinct from META_WHATSAPP_TOKEN. Verifies X-Hub-Signature-256.
META_APP_SECRET=
# E.164 display number for wa.me links (no +). NOT the same as PHONE_ID.
META_WHATSAPP_DISPLAY_NUMBER=

# ── OpenAI (enrichment + LIBRARY search embeddings) ─────────
# Optional in dev — saves still work; AI summary/tags/search degrade.
OPENAI_API_KEY=

# ── Origins ─────────────────────────────────────────────────
# Web app public origin — /s/<shortId> card links + og-fallback.png
BASE_URL=http://localhost:3000
# API public origin — /uploads/* image URLs (must be reachable by Meta)
API_BASE_URL=http://localhost:3001
# CORS allowlist for browser calls from the web app
WEB_ORIGIN=http://localhost:3000
# Browser-side fetch target (save page → POST /api/saves)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Server-side fetch target (OG card page → GET /api/saves/:id)
API_INTERNAL_URL=http://localhost:3001
# OAuth returnTo base (dashboard)
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
# Embed snippet script src origin
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32
JWT_SECRET=

# ── Runtime ─────────────────────────────────────────────────
# api listens on PORT (Docker sets 8080; local default 3001)
# PORT=3001
NODE_ENV=development
