# ── Infrastructure ──────────────────────────────────────────
DATABASE_URL=postgres://sor7ed:sor7ed@localhost:5432/sor7ed
# Optional direct Neon URL for migrations. Runtime API/worker keep DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full
REDIS_URL=redis://localhost:6379

# ── Meta WhatsApp Cloud API ─────────────────────────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WEBHOOK_VERIFY_TOKEN=
# App secret from Meta App Dashboard → Settings → Basic.
# Distinct from META_WHATSAPP_TOKEN. Verifies X-Hub-Signature-256.
META_APP_SECRET=
# E.164 display number for wa.me links (no +). NOT the same as PHONE_ID.
META_WHATSAPP_DISPLAY_NUMBER=

# ── OpenAI (enrichment + LIBRARY search embeddings) ─────────
# Optional in dev — saves still work; AI summary/tags/search degrade.
OPENAI_API_KEY=

# ── Uploads storage (Cloudflare R2) ──────────────────────────
# Optional in dev — leave unset and image uploads fall back to local
# disk under core/uploads. REQUIRED in production: api and worker run
# as separate processes (separate disks on Fly/most deploys), so local
# disk storage silently loses images written by one process and read
# by the other. Set all five together.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL images are served from (R2 public bucket URL or a
# custom domain fronting it), no trailing slash.
R2_PUBLIC_URL=
# Optional override for the S3-compatible endpoint; defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# ── Origins ─────────────────────────────────────────────────
# Web app public origin — /s/<shortId> card links + og-fallback.png
BASE_URL=http://localhost:3000
# API public origin — /uploads/* image URLs (must be reachable by Meta)
API_BASE_URL=http://localhost:3001
# CORS allowlist for browser calls from the web app
WEB_ORIGIN=http://localhost:3000
# Browser-side fetch target (save page → POST /api/saves)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Server-side fetch target (OG card page → GET /api/saves/:id)
API_INTERNAL_URL=http://localhost:3001
# OAuth returnTo base (dashboard)
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
# Embed snippet script src origin
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32
JWT_SECRET=
# Shared parent domain for session cookie when web + api are on
# sibling subdomains (e.g. sor7ed.com + api.sor7ed.com).
# MUST start with a dot. Leave blank for localhost.
# COOKIE_DOMAIN=.sor7ed.com

# ── Runtime ─────────────────────────────────────────────────
# api listens on PORT (Docker/Fly set 8080; local default 3001)
# PORT=3001
NODE_ENV=development
